{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "TechshopEcommerce.Api",
    "Audience": "TechshopEcommerceUser",
    "DurationInMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenCookieName": "refreshToken"
  },
  "StripeSettings": {
    "SecretKey": "",
    "WebhookSecret": "",
    "SuccessUrl": "",
    "CancelUrl": "",
    "Currency": ""
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromAddress": "",
    "FromName": "TechShop ECommerce"
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ProductImagesContainerName": "product-images",
    "ReadUrlExpiryMinutes": 30
  },
  "OpenTelemetry": {
    "ServiceName": "techshop-api",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AI": {
    "Provider": "Ollama",
    "Ingestion": {
      "BatchSize": 20,
      "BatchDelayMs": 200
    },
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1/",
      "EmbeddingModel": "text-embedding-3-small",
      "ChatModel": "gpt-4o-mini",
      "Dimensions": 1536
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  }
}
