{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "TechshopEcommerce.Api",
    "Audience": "TechshopEcommerceUser",
    "DurationInMinutes": 15
  },
  "StripeSettings": {
    "SecretKey": "",
    "WebhookSecret": "",
    "SuccessUrl": "",
    "CancelUrl": "",
    "Currency": ""
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromAddress": "",
    "FromName": "TechShop ECommerce"
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "product-images"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  }
